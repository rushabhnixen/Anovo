# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production

# Free AI chat — get keys at https://console.groq.com (no credit card needed)
# Multiple keys for rate-limit rotation (comma-separated, recommended):
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4
# Single key (backward compatible, used if GROQ_API_KEYS is empty):
GROQ_API_KEY=

# HuggingFace Inference API — fallback when Groq is unavailable
# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Premium tier ──────────────────────────────────────────────────────────────
# GitHub Models (requires GitHub PAT with Models scope — free with Student Pack)
# GITHUB_PAT=ghp_your_github_pat_here
# GITHUB_MODEL=Meta-Llama-3.1-405B-Instruct

# Promo codes that unlock premium (comma-separated)
# PREMIUM_PROMO_CODES=LAUNCH2024,BETAUSER

# ── Optional overrides ────────────────────────────────────────────────────────
# Grammar: defaults to public languagetool.org API (free, no key needed)
# Override to point at a self-hosted LanguageTool container
# LANGUAGETOOL_URL=http://localhost:8010

# Ollama fallback (only used if GROQ_API_KEY is not set)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Database (SQLite by default, works out of the box)
# DATABASE_URL=sqlite:///./anovo.db
# For Postgres: DATABASE_URL=postgresql://user:pass@host:5432/anovo

# CORS — JSON array of allowed frontend origins
# CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
