{
  "manifest_version": 3,
  "name": "Anovo — AI Writing Tool",
  "version": "1.3.0",
  "description": "Rewrite and edit selected text with Anovo's unified AI writing workspace.",
  "permissions": ["activeTab", "contextMenus", "storage", "sidePanel", "scripting"],
  "host_permissions": ["https://rushabh13-anovo-api.hf.space/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
