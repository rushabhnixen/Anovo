{
  "manifest_version": 3,
  "name": "Anovo — AI Writing Tool",
  "version": "1.2.0",
  "description": "Humanize, paraphrase, grammar check, summarize, translate, and more — right from your browser.",
  "permissions": ["activeTab", "contextMenus", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
